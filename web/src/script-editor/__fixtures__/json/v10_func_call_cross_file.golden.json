{
  "id": "v10_func_call_cross_file",
  "kind": "valid",
  "description": "跨文件函数调用：func: 文件短路径/函数名，args 具名传参，then/else 布尔分支；辅助文件为函数库 common",
  "files": [
    {
      "file": "v10_func_call_cross_file.yaml",
      "role": "main",
      "model_kind": "script",
      "model": {
        "params": [
          { "type": "tmpl", "name": "account", "remark": "账号模板", "default": "account.png" }
        ],
        "config": null,
        "steps": [
          {
            "kind": "func",
            "target": "common/login",
            "args": {
              "account": { "ref": "account" },
              "timeout": { "lit": "30s" }
            },
            "then": [{ "kind": "log", "message": { "lit": "登录成功" } }],
            "else": [{ "kind": "throw", "message": "登录失败" }]
          }
        ]
      }
    },
    {
      "file": "v10_func_call_cross_file.common.yaml",
      "role": "func_library_common",
      "model_kind": "function_library",
      "model": {
        "file": "common",
        "functions": [
          {
            "name": "login",
            "params": [
              { "type": "tmpl", "name": "account", "remark": "登录账号模板", "default": null },
              { "type": "time", "name": "timeout", "remark": "等待超时", "default": null }
            ],
            "steps": [
              {
                "kind": "find",
                "template": { "ref": "account" },
                "block": [],
                "verify": false,
                "timeout": { "ref": "timeout" },
                "then": [],
                "else": []
              },
              { "kind": "return", "value": { "lit": true } }
            ]
          },
          {
            "name": "is_enabled",
            "params": [
              { "type": "bool", "name": "enable", "remark": "开关", "default": null }
            ],
            "steps": [
              { "kind": "return", "value": { "ref": "enable" } }
            ]
          }
        ]
      }
    }
  ]
}
