{
  "id": "v09_call_script",
  "kind": "valid",
  "description": "脚本 call（带 args）：参数引用与字面量两种实参，目标脚本 delay 有默认值可省略",
  "files": [
    {
      "file": "v09_call_script.yaml",
      "role": "main",
      "model_kind": "script",
      "model": {
        "params": [
          { "type": "bool", "name": "enable", "remark": "是否启用", "default": true },
          { "type": "text", "name": "message", "remark": "提示文本", "default": "来自父脚本" }
        ],
        "config": null,
        "steps": [
          {
            "kind": "call",
            "target": "v09_call_script.target.yaml",
            "args": {
              "enable": { "ref": "enable" },
              "message": { "ref": "message" }
            }
          },
          {
            "kind": "call",
            "target": "v09_call_script.target.yaml",
            "args": {
              "enable": { "lit": false },
              "message": { "lit": "字面量消息" }
            }
          }
        ]
      }
    },
    {
      "file": "v09_call_script.target.yaml",
      "role": "call_target",
      "model_kind": "script",
      "model": {
        "params": [
          { "type": "bool", "name": "enable", "remark": "子任务开关", "default": null },
          { "type": "text", "name": "message", "remark": "子任务消息", "default": null },
          { "type": "time", "name": "delay", "remark": "执行前延迟", "default": "500ms" }
        ],
        "config": null,
        "steps": [
          { "kind": "wait", "duration": { "ref": "delay" }, "duration_max": null },
          { "kind": "log", "message": { "ref": "message" } },
          {
            "kind": "if",
            "cond": { "ref": "enable" },
            "then": [{ "kind": "tap", "at": { "lit": [0.5, 0.5] } }],
            "else": []
          }
        ]
      }
    }
  ]
}
