{
  "scenario": "PUT /api/system/update/policy 字段非法（start == end 的维护窗口）→ 400 invalid_argument，details.field 指明字段",
  "endpoint": "PUT /api/system/update/policy",
  "request": {
    "method": "PUT",
    "path": "/api/system/update/policy",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Origin": "https://gamebot.local:8443"
    },
    "cookies": ["gb_session=<会话 Cookie>"],
    "body": {
      "strategy": "auto",
      "maintenance_window": { "start": "02:00", "end": "02:00" },
      "freeze_window_minutes": 30
    }
  },
  "response": {
    "status": 400,
    "body": {
      "code": "invalid_argument",
      "message": "维护窗口起止时间不能相同",
      "details": {
        "field": "maintenance_window"
      }
    }
  }
}
