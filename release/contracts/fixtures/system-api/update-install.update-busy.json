{
  "scenario": "已有升级/回滚事务进行中（或对 install 的并发第二个请求）→ 409 update_busy；两个 install 只有一个取得事务（计划 §11.4）",
  "endpoint": "POST /api/system/update/install",
  "request": {
    "method": "POST",
    "path": "/api/system/update/install",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Origin": "https://gamebot.local:8443"
    },
    "cookies": ["gb_session=<会话 Cookie>"],
    "body": {}
  },
  "response": {
    "status": 409,
    "body": {
      "code": "update_busy",
      "message": "已有升级事务正在进行，请等待其结束后再试"
    }
  }
}
