  {
    "description": "等待模板出现，默认点击命中中心（click: false 仅等待）；超时返回 null",
    "name": "wait_find",
    "params": [
      {
        "default": null,
        "desc": "模板短名",
        "name": "template",
        "required": true,
        "type": "template"
      },
      {
        "name": "obstacles",
        "type": "list",
        "required": false,
        "default": [],
        "desc": "障碍模板：按顺序命中首个就点击，下轮重新检查；计入总超时",
        "items": {
          "type": "template"
        }
      },
      {
        "name": "click",
        "type": "boolean",
        "required": false,
        "default": true,
        "desc": "命中后是否点击模板中心（前后延迟使用自动化设置）"
      },
      {
        "default": 0.8,
        "desc": "匹配阈值 0..1",
        "name": "threshold",
        "required": false,
        "type": "number"
      },
      {
        "default": "10s",
        "desc": "等待上限",
        "name": "timeout",
        "required": false,
        "type": "duration"
      },
      {
        "default": "250ms",
        "desc": "轮询间隔",
        "name": "interval",
        "required": false,
        "type": "duration"
      },
      {
        "default": null,
        "desc": "搜索区域 [x, y, w, h]（相对坐标）",
        "name": "region",
        "required": false,
        "type": "list"
      },
      {
        "name": "name",
        "type": "string",
        "required": false,
        "default": "等待模板出现",
        "desc": "可视化显示名称"
      }
    ],
    "returns": "match?",
    "source": "plugin"
  },
