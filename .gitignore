# ===== Rust (server) =====
server/target/
# RC 独立构建目录（正式服务运行中锁定 target/release 时的替代产物位，同不入库）
server/target-rc/
# 本机配置（真实路径/密码，不入库）；分发以 server/config.example.toml 为准
server/config.toml
# 按天轮转的日志产物（gamer-server.log.YYYY-MM-DD；裸 *.log 规则盖不住带日期后缀的名）
server/gamer-server.log.*
# GB_LOG 误设裸词（无目录成分）时轮转文件落在 server/ 根，名如 1.2026-08-30
server/*.20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]
# 运行时产物不入库；模板/脚本分区目录 server/data/<pkg>/{tmpl,yaml} 需入库
server/data/gamer.db
server/data/*.db-shm
server/data/*.db-wal
server/data/pending_restore.json

# ===== Docker 并存部署（docker-compose.local.yml，宿主 8444）=====
# 独立数据目录（volume 挂载，本机运行数据不随仓库分发）：需要种子分区时
# 从 server/data/<pkg> 自行复制
docker-data/

# ===== Node (web) =====
web/node_modules/
web/dist/

# ===== 运行时/调试产物 =====
mcp-test/
/data/   # 仅忽略仓库根目录遗留的旧 data/；server/data/<pkg> 分区需入库
*.log
run-body.json

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地调试产物 =====
.chrome-test-profile/
.zcode/
tools/mcp-client/node_modules/
tools/mcp-client/out/
server/web-dist/

# ===== 本地任务笔记 =====
prompt.md

# ===== 阶段备份（重构发布前的只读数据快照，如 backups/stage0-data）=====
backups/

# ===== Release 运行依赖 vendor（DEP-002/003：adb/ffmpeg 二进制绝不入库）=====
# 由 release/packaging/fetch-adb.ps1 / fetch-ffmpeg.ps1 按锁文件重建；含下载缓存
release/vendor/

# ===== Release 打包/签名/SBOM 运行产物（REL-001/002/003，全部可由脚本重建）=====
# dist: package-app / package-components / package-full 的 zip 与临时 staging
release/dist/
# sbom: tools/gen-sbom.ps1 的 CycloneDX 输出
release/sbom/
# manifests: gen-manifest.ps1 产物（json+sig，随 dist 内容变化，随发布资产归档）
release/manifests/
# 签名私钥绝不入库；公钥 <key_id>.pem 允许提交（验签信任库）
release/keys/*.private.pem
