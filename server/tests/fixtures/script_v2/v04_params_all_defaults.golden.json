{
  "id": "v04_params_all_defaults",
  "kind": "valid",
  "description": "七类参数全带默认值 + config 三键 + 七类参数全部被步骤引用",
  "files": [
    {
      "file": "v04_params_all_defaults.yaml",
      "role": "main",
      "model_kind": "script",
      "model": {
        "params": [
          { "type": "tmpl", "name": "account", "remark": "账号模板", "default": "account.png" },
          { "type": "coord", "name": "click_pos", "remark": "点击位置", "default": [0.5, 0.8] },
          { "type": "color", "name": "target_color", "remark": "目标颜色", "default": "ff8800" },
          { "type": "time", "name": "timeout", "remark": "最长等待", "default": "30s" },
          { "type": "key", "name": "cancel_key", "remark": "取消按键", "default": "ESC" },
          { "type": "text", "name": "message", "remark": "提示文本", "default": "示例文本" },
          { "type": "bool", "name": "enable", "remark": "是否启用", "default": true }
        ],
        "config": { "interval": "500ms", "threshold": 0.85, "log_level": "info" },
        "steps": [
          {
            "kind": "if",
            "cond": { "ref": "enable" },
            "then": [{ "kind": "tap", "at": { "ref": "click_pos" } }],
            "else": []
          },
          {
            "kind": "find",
            "template": { "ref": "account" },
            "block": [],
            "verify": false,
            "timeout": { "ref": "timeout" },
            "then": [],
            "else": []
          },
          { "kind": "key", "key": { "ref": "cancel_key" } },
          { "kind": "log", "message": { "ref": "message" } },
          {
            "kind": "color",
            "at": { "lit": [0.25, 0.75] },
            "expect": [
              {
                "color": { "ref": "target_color" },
                "steps": [{ "kind": "log", "message": { "lit": "参数色命中" } }]
              },
              {
                "color": { "lit": "ff8800" },
                "steps": [{ "kind": "log", "message": { "lit": "字面色命中" } }]
              }
            ],
            "else": [{ "kind": "log", "message": { "lit": "都未命中" } }]
          }
        ]
      }
    }
  ]
}
